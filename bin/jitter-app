#!/usr/bin/env python3
"""jitter-app – Fenster mit allen jitterlog-Messungen (Verlauf, Vergleich der Ziele, Tagesprofil).

Startet einen kleinen lokalen Server (127.0.0.1:8766) und öffnet die Seite als
Omarchy-Web-App. Der Server beendet sich selbst, wenn das Fenster zu ist.
Daten: ~/.local/state/jitterlog/*.csv (+ frische Zeilen vom Router, falls er mitmisst).
"""
import glob, http.server, json, os, socket, subprocess, sys, threading, time
from datetime import datetime

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from jitterlog_common import STATE, config, parse, router_tail, ssh_env  # noqa: E402

PORT = int(os.environ.get("JITTER_PORT", 8766))
IDLE_EXIT = 45  # Sekunden ohne Abfrage -> Server beendet sich

last_hit = time.time()
cache = {"t": 0, "data": None}
lock = threading.Lock()


def fetch():
    cfg = config()
    rows, error = {}, None
    for f in sorted(glob.glob(os.path.join(STATE, "*.csv"))):
        parse(open(f).read(), rows)
    if cfg["ROUTER"]:
        try:
            parse(router_tail(cfg, f"{datetime.now():%Y-%m}", 2400), rows)
        except Exception as e:
            error = f"{e} – zeige nur gespeicherte Daten"
    cs2 = {}
    for f in sorted(glob.glob(os.path.join(STATE, "cs2-*.txt"))):
        for line in open(f):
            r = line.rstrip("\n").split(",")
            if len(r) == 5 and r[0] != "zeit":
                cs2[r[0]] = r[1:4]
    return {"rows": sorted(rows.values()), "cs2": sorted([k] + v for k, v in cs2.items()),
            "mode": "router" if cfg["ROUTER"] else "pc", "gameName": cfg["GAME_NAME"],
            "error": error, "now": datetime.now().isoformat(timespec="seconds")}


def get_data():
    with lock:
        if time.time() - cache["t"] > 20 or cache["data"] is None:
            cache["data"] = fetch()
            cache["t"] = time.time()
        return cache["data"]


class H(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def do_GET(self):
        global last_hit
        last_hit = time.time()
        if self.path.startswith("/data"):
            body, ctype = json.dumps(get_data()).encode(), "application/json"
        elif self.path.startswith("/alive"):
            body, ctype = b"ok", "text/plain"
        else:
            body, ctype = PAGE.encode(), "text/html; charset=utf-8"
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)


def port_in_use():
    with socket.socket() as s:
        return s.connect_ex(("127.0.0.1", PORT)) == 0


def serve():
    # gespeicherte Daten im Hintergrund auffrischen (holt den ganzen Monat vom Router)
    if config()["ROUTER"]:
        subprocess.Popen([os.path.join(os.path.dirname(os.path.realpath(__file__)), "jitterlog-sync")],
                         env=ssh_env(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    srv = http.server.ThreadingHTTPServer(("127.0.0.1", PORT), H)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    while time.time() - last_hit < IDLE_EXIT:
        time.sleep(5)
    srv.shutdown()


PAGE = r'''<!doctype html>
